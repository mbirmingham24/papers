# Copy to .env for local dev. Every setting in app/core/config.py is listed here.

# local | test | prod
ENVIRONMENT=local

# Required (no default). SQLAlchemy URL; the +asyncpg driver is required (the app is async).
# From the host: 127.0.0.1, not localhost (on Windows that tries IPv6 first and stalls ~2 s). Inside docker-compose: host is "postgres" (set in docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://papers:papers@127.0.0.1:5432/papers

# Required (no default). redis:// is plain TCP; rediss:// is TLS (Upstash requires it).
# From the host: 127.0.0.1, not localhost (on Windows that tries IPv6 first and stalls ~2 s). Inside docker-compose: host is "redis" (set in docker-compose.yml).
REDIS_URL=redis://127.0.0.1:6379/0
