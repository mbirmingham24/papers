# Copy to .env for local dev. Every setting in app/core/config.py is listed here.

# local | test | prod
ENVIRONMENT=local

# Required (no default). SQLAlchemy URL; the +asyncpg driver is required (the app is async).
# From the host: localhost. Inside docker-compose: host is "postgres" (set in docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://papers:papers@localhost:5432/papers

# Required (no default). redis:// is plain TCP; rediss:// is TLS (Upstash requires it).
# From the host: localhost. Inside docker-compose: host is "redis" (set in docker-compose.yml).
REDIS_URL=redis://localhost:6379/0
